{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*",
    "../plugins/**/server.ts",
    "../plugins/**/manifest.ts",
    "../plugins/media/scripts/backfill-games-to-igdb.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
