{
  "name": "wherewewere-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "backfill:checkin-timezone": "tsx ../plugins/location/scripts/backfill-checkin-timezone.ts",
    "backfill:track-max-speeds": "tsx ../plugins/tracks/scripts/backfill-track-max-speeds.ts",
    "backfill:track-avg-speeds": "tsx ../plugins/tracks/scripts/backfill-track-avg-speeds.ts",
    "backfill:tgdb-external-urls": "tsx ../plugins/media/scripts/backfill-tgdb-external-urls.ts",
    "backfill:games-external-ids": "tsx ../plugins/media/scripts/backfill-games-external-ids.ts",
    "backfill:games-to-igdb": "tsx ../plugins/media/scripts/backfill-games-to-igdb.ts",
    "import:games": "tsx ../plugins/media/scripts/import-games-csv.ts",
    "import:ride-ratings": "tsx ../plugins/location/scripts/import-ride-ratings.ts",
    "import:ride-log": "tsx ../plugins/location/scripts/import-ride-log.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "DATABASE_URL=${DATABASE_URL:-postgres://wherewewere:wherewewere@localhost:5432/wherewewere_test} vitest run -c vitest.integration.config.ts",
    "test:integration:watch": "DATABASE_URL=${DATABASE_URL:-postgres://wherewewere:wherewewere@localhost:5432/wherewewere_test} vitest -c vitest.integration.config.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.6",
    "wwp-shared": "*",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "geo-tz": "^8.1.8",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "unzipper": "^0.12.5",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/unzipper": "^0.10.11",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
