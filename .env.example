# Ports
DB_PORT=5432
SERVER_PORT=3001
CLIENT_PORT=5173

# Database
DATABASE_URL=postgres://wherewewere:wherewewere@localhost:5432/wherewewere

# Integration tests (npm run test:integration) TRUNCATE their database. Use a separate
# database whose name contains "test"; it is created automatically if missing.
TEST_DATABASE_URL=postgres://wherewewere:wherewewere@localhost:5432/wherewewere_test

# development|production
NODE_ENV=development

# Session secret (change in production)
SESSION_SECRET=change-me-in-production

# Comma-separated allowed browser origins for CORS.
# Example: CORS_ORIGINS=https://journal.example.com,https://www.journal.example.com
CORS_ORIGINS=

# Photon geocoder base URL (reverse geocoding + place search). Venue coordinates
# are sent to this host. Point it at your own instance, or a public one such as
# https://photon.komoot.io. Unset falls back to the project author's instance.
PHOTON_URL=

# Set to true when running behind a reverse proxy (Traefik, Caddy, Nginx, etc).
TRUST_PROXY=false

# Directory for user data files (uploaded GPS tracks, etc).
# Defaults to <cwd>/data.
DATA_DIR=

# Optional. Coasterpedia asks API clients to identify themselves in the User-Agent
# with a web address and an email, so they can reach you before limiting anything.
# Example: COASTERPEDIA_CONTACT=https://example.com; you@example.com
COASTERPEDIA_CONTACT=
